# $Id: local.rules,v 1.11 2004/07/23 20:15:44 bmc Exp $
# ----------------
# LOCAL RULES
# ----------------
# This file intentionally does not come with signatures.  Put your local
# additions here.
alert icmp any any -> $HOME_NET any (msg:"ALERT_ICMP_PING"; itype:8; sid:100001; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"ALERT_ICMP_FLOOD"; itype:8; detection_filter:track by_src, count 10, seconds 5; sid:100002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"ALERT_NMAP_SYN"; flags:S; detection_filter:track by_src, count 10, seconds 3; sid:100003; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"ALERT_PORT_SCAN"; detection_filter:track by_src, count 20, seconds 5; sid:100004; rev:1;)
